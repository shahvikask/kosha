{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --port=3000 --host=0.0.0.0",
    "cas:server": "python3 scripts/cas_parse_server.py",
    "build": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/lib/kosha.test.ts",
    "test:snap": "tsx src/lib/snapshot.test.ts",
    "test:db": "tsx src/db/db.test.ts",
    "tauri": "tauri",
    "android:init": "npx tauri android init",
    "android:prepare": "node scripts/android_prepare.mjs",
    "android:aab": "npx tauri android build --target aarch64",
    "android:apk": "npx tauri android build --apk --target aarch64"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@tauri-apps/cli": "^2.11.4"
  }
}
